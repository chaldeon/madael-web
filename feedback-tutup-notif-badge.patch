+    if (!ticket) return NextResponse.json({ error: 'Tiket tidak ditemukan.' }, { status: 404 });
+    if (ticket.status === 'selesai') return NextResponse.json({ success: true });
+    if (!ticket.last_staff_at) {
+      return NextResponse.json(
