diff --git a/supabase/migrations/20261009000000_leave_requests_rejection_reason.sql b/supabase/migrations/20261009000000_leave_requests_rejection_reason.sql
new file mode 100644
index 0000000..b45102a
--- /dev/null
+++ b/supabase/migrations/20261009000000_leave_requests_rejection_reason.sql
@@ -0,0 +1,17 @@
+-- Alasan penolakan cuti: simpan catatan admin saat menolak pengajuan, supaya
+-- bisa ditampilkan di riwayat karyawan dan di teks notifikasi (sama seperti
+-- lembur dan reimbursement yang sudah punya kolom rejection_reason).
+--
+-- Nullable: pengajuan lama yang sudah ditolak tetap NULL, dan alasan memang
+-- opsional saat menolak. Tidak ada policy RLS baru: kolom ini ikut policy yang
+-- sudah ada di public.leave_requests (karyawan hanya membaca baris sendiri,
+-- penulisan dilakukan server lewat /api/leave-requests/[id]/decision dengan
+-- service role), jadi tidak ada risiko rekursi RLS.
+-- Aman dijalankan ulang (IF NOT EXISTS).
+-- Jalankan SEBELUM men-deploy kode baru (menolak cuti akan menulis kolom ini).
+
+alter table public.leave_requests
+  add column if not exists rejection_reason text;
+
+comment on column public.leave_requests.rejection_reason is
+  'Alasan/catatan admin saat menolak pengajuan. NULL = tidak diisi / bukan status rejected.';
