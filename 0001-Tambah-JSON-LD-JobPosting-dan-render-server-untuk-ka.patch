+      setLoading(true);
+      const { data, error } = await supabase
+        .from('job_listings')
+        .select(PUBLIC_JOB_COLUMNS)
+        .eq('slug', slug)
+        .eq('is_active', true)
+        .single();
+
+      if (error) {
+        console.error('Muat lowongan publik:', error);
+        setError(true);
+      } else {
+        setJob(data);
+      }
+      setLoading(false);
+    }
+
+    if (slug && !initialJob) fetchJob();
+  }, [slug, initialJob]);
+
+  const handleShare = async () => {
