+      console.error('Clipboard error:', err);
+    }
+  };
+
+  if (loading) {
+    return (
+      <section className="px-10 py-16 bg-white">
+        <div className="max-w-[900px] mx-auto">
+          <p className="text-sm text-[#6B6B6B]">{t.loading}</p>
+        </div>
+      </section>
