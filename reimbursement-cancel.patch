diff --git a/supabase/migrations/20261021_reimbursement_status_cancelled.sql b/supabase/migrations/20261021_reimbursement_status_cancelled.sql
new file mode 100644
index 0000000..6d0a1f3
--- /dev/null
+++ b/supabase/migrations/20261021_reimbursement_status_cancelled.sql
@@ -0,0 +1,51 @@
+-- Izinkan status 'cancelled' pada reimbursement_requests.
+--
+-- Konteks: karyawan bisa membatalkan klaim reimbursement miliknya yang masih
+-- 'pending' lewat POST /api/reimbursement/[id]/cancel (pola sama dengan cuti
+-- dan lembur). Rute itu menulis status = 'cancelled'; CHECK constraint lama
+-- pada kolom status kemungkinan hanya mengizinkan
+-- pending/approved/rejected/paid, sehingga update akan ditolak Postgres.
+--
+-- Migrasi ini idempotent (aman dijalankan berulang):
+--   1. Menghapus SEMUA CHECK constraint pada reimbursement_requests yang
+--      mereferensikan kolom status (nama constraint di produksi tidak
+--      diketahui dari repo, jadi dicari lewat katalog, bukan ditebak).
+--   2. Membuat ulang satu constraint bernama tetap yang menyertakan 'cancelled'.
+-- Tidak ada perubahan RLS/tabel/kolom lain. Baris yang sudah ada tidak
+-- berubah; constraint baru lebih longgar daripada yang lama, jadi semua baris
+-- lama tetap valid.
+
+DO $$
+DECLARE
+  con record;
+BEGIN
+  IF to_regclass('public.reimbursement_requests') IS NULL THEN
+    RAISE EXCEPTION 'Tabel public.reimbursement_requests tidak ditemukan';
+  END IF;
+
+  FOR con IN
+    SELECT c.conname
+    FROM pg_constraint c
+    JOIN pg_attribute a
+      ON a.attrelid = c.conrelid
+     AND a.attnum = ANY (c.conkey)
+    WHERE c.conrelid = 'public.reimbursement_requests'::regclass
+      AND c.contype = 'c'
+      AND a.attname = 'status'
+  LOOP
+    EXECUTE format(
+      'ALTER TABLE public.reimbursement_requests DROP CONSTRAINT %I',
+      con.conname
+    );
+  END LOOP;
+
+  ALTER TABLE public.reimbursement_requests
+    ADD CONSTRAINT reimbursement_requests_status_check
+    CHECK (status IN ('pending', 'approved', 'rejected', 'paid', 'cancelled'));
+END
+$$;
+
+-- Verifikasi (opsional, jalankan terpisah):
+--   SELECT conname, pg_get_constraintdef(oid)
+--   FROM pg_constraint
+--   WHERE conrelid = 'public.reimbursement_requests'::regclass AND contype = 'c';
