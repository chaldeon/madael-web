 export const PASAL_PAGE_SIZE = 50;
 
+// Pencarian lintas-pasal di halaman daftar (RPC cari_pasal_lintas).
+export const PASAL_LINTAS_MIN_LENGTH = 2; // sama dengan batas kotak cari pasal di PasalList
+export const PASAL_LINTAS_LIMIT = 100; // pasal teratas yang diminta (RPC membatasi maks. 200)
+export const PASAL_LINTAS_GRUP_AWAL = 8; // peraturan yang tampil sebelum "tampilkan semua"
+export const PASAL_LINTAS_PER_PERATURAN = 3; // pasal yang tampil per peraturan sebelum "tampilkan lainnya"
+
+// Baris RPC cari_pasal_lintas (satu baris per pasal) -> dikelompokkan per peraturan,
+// urutan kelompok mengikuti pasal terbaiknya (urutan RPC dipertahankan).
+export function kelompokkanPasalLintas(rows) {
+  const peta = new Map();
+  (rows || []).forEach((r) => {
+    let grup = peta.get(r.peraturan_id);
+    if (!grup) {
+      grup = {
+        id: r.peraturan_id,
+        jenis: r.jenis,
+        nomor: r.nomor,
+        tahun: r.tahun,
+        judul: r.judul_peraturan,
+        status: r.status,
+        pasal: [],
+      };
+      peta.set(r.peraturan_id, grup);
+    }
+    grup.pasal.push(r);
+  });
+  return Array.from(peta.values());
+}
