diff --git a/lib/exportCsv.js b/lib/exportCsv.js
index 9202757..e53d254 100644
--- a/lib/exportCsv.js
+++ b/lib/exportCsv.js
@@ -3,8 +3,16 @@
 // dipakai di halaman mana saja yang sudah punya datanya di state (Reports,
 // Statistics, dan modul lain ke depannya).
 
-function escapeCsvValue(value) {
-  const str = value === null || value === undefined ? '' : String(value);
+// Sel teks berawalan = + - @ (atau tab/CR) dibaca Excel sebagai rumus (CSV injection).
+// Opsional (default mati) karena angka negatif di modul lain tidak boleh diubah;
+// hanya string yang dinetralkan, angka asli (number) tidak disentuh.
+const FORMULA_START = /^[=+\-@\t\r]/;
+
+function escapeCsvValue(value, neutralizeFormulas = false) {
+  let str = value === null || value === undefined ? '' : String(value);
+  if (neutralizeFormulas && typeof value === 'string' && FORMULA_START.test(str)) {
+    str = `'${str}`;
+  }
   if (/[",\n]/.test(str)) {
     return '"' + str.replace(/"/g, '""') + '"';
   }
@@ -12,16 +20,18 @@ function escapeCsvValue(value) {
 }
 
 // headers: [{ key, label }]. rows: array of object (dibaca lewat header.key).
-export function buildCsv(headers, rows) {
+export function buildCsv(headers, rows, { neutralizeFormulas = false } = {}) {
   const headerLine = headers.map((h) => escapeCsvValue(h.label)).join(',');
-  const lines = (rows || []).map((row) => headers.map((h) => escapeCsvValue(row[h.key])).join(','));
+  const lines = (rows || []).map((row) =>
+    headers.map((h) => escapeCsvValue(row[h.key], neutralizeFormulas)).join(',')
+  );
   // \uFEFF (BOM) di depan supaya Excel di Windows baca karakter non-ASCII
   // (mis. "Rp", huruf beraksen) dengan benar — tanpa ini sering muncul mojibake.
   return '\uFEFF' + [headerLine, ...lines].join('\r\n');
 }
 
-export function downloadCsv(filename, headers, rows) {
-  const csv = buildCsv(headers, rows);
+export function downloadCsv(filename, headers, rows, options) {
+  const csv = buildCsv(headers, rows, options);
   const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
   const url = URL.createObjectURL(blob);
   const link = document.createElement('a');
diff --git a/lib/peraturanConfig.js b/lib/peraturanConfig.js
index 4b3e219..e6144c7 100644
--- a/lib/peraturanConfig.js
+++ b/lib/peraturanConfig.js
@@ -478,3 +478,37 @@ export function validateImportRow(cells, index) {
 export function nomorBerawalanNol(nomor) {
   return /^0\d+$/.test(String(nomor ?? '').trim());
 }
+
+// ---------------------------------------------------------------------------
+// Ekspor CSV (sekaligus cadangan) — tombol di /employee/peraturan
+// ---------------------------------------------------------------------------
+
+// Kolom ekspor = kolom impor (IMPORT_COLUMNS) supaya file bisa diimpor ulang.
+// Hanya data header peraturan: pasal, relasi, dan berkas PDF unggahan tidak ikut.
+export const EXPORT_HEADERS = IMPORT_COLUMNS.map((c) => ({ key: c.key, label: c.header }));
+export const EXPORT_SELECT = IMPORT_COLUMNS.map((c) => c.key).join(', ');
+export const EXPORT_ID_CHUNK = 100;
+
+// Satu baris tabel -> baris CSV. Topik dipisah ';' dan keyword ',' (sama dengan
+// aturan impor); sisanya apa adanya (tanggal sudah 'YYYY-MM-DD' dari database).
+export function peraturanToExportRow(row) {
+  return {
+    ...row,
+    topik: (row.topik || []).join(';'),
+    keywords: (row.keywords || []).join(', '),
+  };
+}
+
+// Urutan file: tahun terbaru dulu, lalu jenis (urutan JENIS_OPTIONS), lalu nomor.
+export function sortPeraturanExport(rows) {
+  const jenisIdx = (j) => {
+    const i = JENIS_OPTIONS.indexOf(j);
+    return i < 0 ? JENIS_OPTIONS.length : i;
+  };
+  return [...rows].sort(
+    (a, b) =>
+      (b.tahun || 0) - (a.tahun || 0) ||
+      jenisIdx(a.jenis) - jenisIdx(b.jenis) ||
+      String(a.nomor ?? '').localeCompare(String(b.nomor ?? ''), 'id', { numeric: true })
+  );
+}
