       logActivity(supabase, {
diff --git a/components/peraturan/RevisiPanel.js b/components/peraturan/RevisiPanel.js
new file mode 100644
index 0000000..bb406d1
--- /dev/null
+++ b/components/peraturan/RevisiPanel.js
@@ -0,0 +1,338 @@
+'use client';
+
+import { useCallback, useRef, useState } from 'react';
+import { ChevronDown, ChevronRight, History, RotateCcw } from 'lucide-react';
+import { createClient } from '@/lib/supabase-browser';
+import { logActivity } from '@/lib/activityLog';
+import { friendlyError } from '@/lib/errorMessage';
+import { formatTanggalWaktu, labelPeraturan } from '@/lib/peraturanConfig';
+import {
+  REVISI_KOLOM_ISI, REVISI_KOLOM_PDF, AKSI_REVISI_LABEL, REVISI_LIST_COLUMNS, REVISI_LIMIT,
+  selisihSnapshot, ringkasPdf, pesanErrorRevisi, muatNamaKaryawan,
+} from '@/lib/peraturanRevisi';
+import LoadingState from '@/components/LoadingState';
+import ErrorState from '@/components/ErrorState';
+import EmptyState from '@/components/EmptyState';
+import ConfirmDialog from '@/components/ConfirmDialog';
+
+// Tabel selisih per kolom. Teks panjang (ringkasan) dibatasi tinggi dan bisa digulir.
+function TabelSelisih({ selisih }) {
+  return (
+    <div className="overflow-x-auto">
+      <table className="w-full text-xs border border-[#E0E0E0]">
+        <thead>
+          <tr className="bg-[#F4F4F4] text-left text-[#6B6B6B]">
+            <th className="px-2 py-1.5 font-medium w-[22%]">Kolom</th>
+            <th className="px-2 py-1.5 font-medium w-[39%]">Sebelum</th>
+            <th className="px-2 py-1.5 font-medium w-[39%]">Sesudah</th>
+          </tr>
+        </thead>
+        <tbody>
+          {selisih.map((s) => (
+            <tr key={s.key} className="border-t border-[#E0E0E0] align-top">
+              <td className="px-2 py-1.5 text-[#3D3D3D]">{s.label}</td>
+              <td className="px-2 py-1.5 text-[#3D3D3D]">
+                <div className="max-h-32 overflow-auto whitespace-pre-line break-words">{s.sebelum}</div>
+              </td>
+              <td className="px-2 py-1.5 text-black">
+                <div className="max-h-32 overflow-auto whitespace-pre-line break-words">{s.sesudah}</div>
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+    </div>
+  );
+}
+
+// Bagian "Riwayat Revisi" di halaman detail peraturan. Dimuat saat dibuka (bukan
+// saat halaman dimuat). Baca = semua pemegang flag (RLS); pulihkan = superadmin
+// pemegang flag (dicek di dalam RPC; `canEdit` hanya kosmetik).
+export default function RevisiPanel({ row, canEdit, employee, onRestored }) {
+  const supabase = createClient();
+
+  const [open, setOpen] = useState(false);
+  const [items, setItems] = useState(null); // null = belum dimuat
+  const [nama, setNama] = useState({});
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState('');
+
+  const [expanded, setExpanded] = useState(null); // id revisi yang dibuka
+  const [detail, setDetail] = useState({}); // id -> { status, selisih?, info? }
+
+  const [target, setTarget] = useState(null); // { rev, selisih } menunggu konfirmasi
+  const [busyId, setBusyId] = useState(null);
+  const [restoring, setRestoring] = useState(false);
+  const [actionError, setActionError] = useState('');
+  const [notice, setNotice] = useState('');
+  const reqToken = useRef(0);
+
+  const load = useCallback(async () => {
+    const token = ++reqToken.current;
+    setLoading(true);
+    setError('');
+    const { data, error: err } = await supabase
+      .from('peraturan_revisi')
+      .select(REVISI_LIST_COLUMNS)
+      .eq('peraturan_id', row.id)
+      .order('versi', { ascending: false })
+      .limit(REVISI_LIMIT);
+    if (token !== reqToken.current) return;
+    if (err) {
+      setError(friendlyError(err, 'Gagal memuat riwayat revisi.', { context: 'Riwayat revisi peraturan' }));
+      setLoading(false);
+      return;
+    }
+    const names = await muatNamaKaryawan(supabase, (data || []).map((r) => r.diubah_oleh));
+    if (token !== reqToken.current) return;
+    setItems(data || []);
+    setNama(names);
+    setDetail({});
+    setExpanded(null);
+    setLoading(false);
+  }, [supabase, row.id]);
+
+  const toggleOpen = () => {
+    const next = !open;
+    setOpen(next);
+    if (next && items === null) load();
+  };
+
+  // Selisih versi ini terhadap versi sebelumnya (butuh dua snapshot).
+  const toggleItem = async (rev) => {
+    if (expanded === rev.id) {
+      setExpanded(null);
+      return;
+    }
+    setExpanded(rev.id);
+    if (detail[rev.id]?.status === 'ok') return;
+
+    setDetail((prev) => ({ ...prev, [rev.id]: { status: 'loading' } }));
+    const { data, error: err } = await supabase
+      .from('peraturan_revisi')
+      .select('versi, snapshot')
+      .eq('peraturan_id', row.id)
+      .in('versi', [rev.versi, rev.versi - 1]);
+    if (err || !data) {
+      if (err) friendlyError(err, 'Gagal memuat rincian revisi.', { context: 'Rincian revisi peraturan' });
+      setDetail((prev) => ({ ...prev, [rev.id]: { status: 'error' } }));
+      return;
+    }
+    const ini = data.find((d) => d.versi === rev.versi)?.snapshot;
+    const sebelumnya = data.find((d) => d.versi === rev.versi - 1)?.snapshot;
+    setDetail((prev) => ({
+      ...prev,
+      [rev.id]: {
+        status: 'ok',
+        pertama: !sebelumnya,
+        selisih: sebelumnya ? selisihSnapshot(sebelumnya, ini, REVISI_KOLOM_ISI) : [],
+        pdfBerubah: sebelumnya && ringkasPdf(sebelumnya) !== ringkasPdf(ini)
+          ? { sebelum: ringkasPdf(sebelumnya) || '—', sesudah: ringkasPdf(ini) || '—' }
+          : null,
+      },
+    }));
+  };
+
+  // Ambil snapshot revisi, bandingkan dengan isi saat ini, lalu minta konfirmasi.
+  const mintaPulihkan = async (rev) => {
+    setActionError('');
+    setNotice('');
+    setBusyId(rev.id);
+    const { data, error: err } = await supabase
+      .from('peraturan_revisi')
+      .select('snapshot')
+      .eq('id', rev.id)
+      .maybeSingle();
+    setBusyId(null);
+    if (err || !data) {
+      setActionError(
+        err ? friendlyError(err, 'Gagal memuat revisi.', { context: 'Pulihkan revisi peraturan' }) : 'Revisi tidak ditemukan.'
+      );
+      return;
+    }
+    const selisih = selisihSnapshot(row, data.snapshot, REVISI_KOLOM_ISI);
+    if (selisih.length === 0) {
+      setNotice(`Isi peraturan sudah sama dengan versi ${rev.versi}; tidak ada yang perlu dipulihkan.`);
+      return;
+    }
+    setTarget({ rev, selisih });
+  };
+
+  const handlePulihkan = async () => {
+    if (!target) return;
+    setRestoring(true);
+    setActionError('');
+    const { data, error: err } = await supabase.rpc('pulihkan_peraturan_revisi', {
+      p_revisi_id: target.rev.id,
+    });
+    setRestoring(false);
+    if (err) {
+      setActionError(pesanErrorRevisi(err, 'Gagal memulihkan revisi.', 'Pulihkan revisi peraturan'));
+      setTarget(null);
+      return;
+    }
+
+    logActivity(supabase, {
+      userId: employee.id,
+      aksi: 'pulihkan_revisi_peraturan',
+      targetTable: 'peraturan',
+      targetId: row.id,
+      detail: {
+        peraturan: labelPeraturan(row),
+        judul: row.judul,
+        dari_versi: data?.versi_sumber ?? target.rev.versi,
+        versi_baru: data?.versi_baru ?? null,
+        kolom_berubah: target.selisih.map((s) => s.key),
+      },
+    });
+    setTarget(null);
+    setNotice(`Isi dipulihkan ke versi ${target.rev.versi}${data?.versi_baru ? ` (tercatat sebagai versi ${data.versi_baru})` : ''}.`);
+    await onRestored?.();
+    await load();
+  };
+
+  const versiById = new Map((items || []).map((r) => [r.id, r.versi]));
+  const terbaru = items?.[0]?.id;
+
+  return (
+    <div className="mt-6 pt-6 border-t border-[#E0E0E0]">
+      <button
+        type="button"
+        onClick={toggleOpen}
+        className="inline-flex items-center gap-2 text-sm font-medium text-black hover:text-madael-red"
+        aria-expanded={open}
+      >
+        {open ? <ChevronDown size={14} /> : <ChevronRight size={14} />}
+        <History size={14} />
+        Riwayat Revisi
+      </button>
+
+      {open && (
+        <div className="mt-3">
+          {notice && <p className="text-xs text-green-700 mb-3">{notice}</p>}
+          {actionError && <p className="text-xs text-red-600 mb-3">{actionError}</p>}
+
+          {loading && <LoadingState label="Memuat riwayat..." />}
+          {!loading && error && <ErrorState message={error} onRetry={load} />}
+          {!loading && !error && items && items.length === 0 && (
+            <EmptyState message="Belum ada riwayat revisi." />
+          )}
+
+          {!loading && !error && items && items.length > 0 && (
+            <>
+              <ul className="border border-[#E0E0E0] divide-y divide-[#E0E0E0]">
+                {items.map((rev) => {
+                  const isOpen = expanded === rev.id;
+                  const d = detail[rev.id];
+                  const dariVersi = rev.sumber_revisi_id ? versiById.get(rev.sumber_revisi_id) : null;
+                  return (
+                    <li key={rev.id}>
+                      <div className="flex flex-wrap items-center gap-x-3 gap-y-1 px-3 py-2">
+                        <button
+                          type="button"
+                          onClick={() => toggleItem(rev)}
+                          className="inline-flex items-center gap-2 text-sm text-black hover:text-madael-red text-left"
+                          aria-expanded={isOpen}
+                        >
+                          {isOpen ? <ChevronDown size={13} /> : <ChevronRight size={13} />}
+                          <span className="font-medium">Versi {rev.versi}</span>
+                          <span className="text-[#3D3D3D]">{AKSI_REVISI_LABEL[rev.aksi] || rev.aksi}</span>
+                        </button>
+                        {rev.id === terbaru && (
+                          <span className="text-[10px] font-medium uppercase tracking-[0.04em] px-2 py-0.5 bg-[#F4F4F4] text-[#6B6B6B]">
+                            Saat ini
+                          </span>
+                        )}
+                        {rev.sumber_revisi_id && (
+                          <span className="text-xs text-[#6B6B6B]">
+                            dipulihkan{dariVersi ? ` dari versi ${dariVersi}` : ' dari revisi lain'}
+                          </span>
+                        )}
+                        <span className="text-xs text-[#9A9A9A] ml-auto">
+                          {formatTanggalWaktu(rev.diubah_pada)}
+                          {' · '}
+                          {rev.diubah_oleh ? nama[rev.diubah_oleh] || '—' : 'Sistem / SQL Editor'}
+                        </span>
+                        {canEdit && rev.id !== terbaru && rev.aksi !== 'hapus' && (
+                          <button
+                            type="button"
+                            onClick={() => mintaPulihkan(rev)}
+                            disabled={busyId === rev.id}
+                            className="inline-flex items-center gap-1.5 border border-[#E0E0E0] px-3 py-1 text-xs text-black hover:border-madael-red hover:text-madael-red transition-colors disabled:opacity-50"
+                          >
+                            <RotateCcw size={12} />
+                            {busyId === rev.id ? 'Memuat...' : 'Pulihkan versi ini'}
+                          </button>
+                        )}
+                      </div>
+
+                      {isOpen && (
+                        <div className="px-3 pb-3">
+                          {(!d || d.status === 'loading') && <LoadingState label="Memuat rincian..." />}
+                          {d?.status === 'error' && (
+                            <p className="text-xs text-red-600">Gagal memuat rincian revisi.</p>
+                          )}
+                          {d?.status === 'ok' && (
+                            <>
+                              {d.pertama && (
+                                <p className="text-xs text-[#6B6B6B]">
+                                  {rev.aksi === 'awal'
+                                    ? 'Keadaan saat riwayat diaktifkan. Tidak ada versi sebelumnya untuk dibandingkan.'
+                                    : 'Versi pertama. Tidak ada versi sebelumnya untuk dibandingkan.'}
+                                </p>
+                              )}
+                              {!d.pertama && rev.aksi === 'hapus' && (
+                                <p className="text-xs text-[#6B6B6B]">
+                                  Peraturan dihapus beserta {rev.jumlah_relasi ?? 0} relasi dan {rev.jumlah_pasal ?? 0} pasal.
+                                  Pemulihan lewat halaman Terhapus di daftar peraturan.
+                                </p>
+                              )}
+                              {!d.pertama && rev.aksi !== 'hapus' && d.selisih.length > 0 && (
+                                <TabelSelisih selisih={d.selisih} />
+                              )}
+                              {!d.pertama && rev.aksi !== 'hapus' && d.selisih.length === 0 && !d.pdfBerubah && (
+                                <p className="text-xs text-[#6B6B6B]">
+                                  Tidak ada perubahan isi yang terlihat (mis. hanya urutan topik/keyword berubah).
+                                </p>
+                              )}
+                              {d.pdfBerubah && (
+                                <p className="text-xs text-[#6B6B6B] mt-2">
+                                  {REVISI_KOLOM_PDF[0].label}: {d.pdfBerubah.sebelum} → {d.pdfBerubah.sesudah}
+                                </p>
+                              )}
+                            </>
+                          )}
+                        </div>
+                      )}
+                    </li>
+                  );
+                })}
+              </ul>
+              <p className="text-[11px] text-[#9A9A9A] mt-2">
+                Menampilkan maksimal {REVISI_LIMIT} revisi terbaru. Memulihkan versi lama menambah revisi baru; riwayat tidak
+                ditimpa. Berkas PDF unggahan, relasi, dan pasal tidak ikut dikembalikan saat memulihkan versi lama.
+              </p>
+            </>
+          )}
+        </div>
+      )}
+
+      <ConfirmDialog
+        open={!!target}
+        title="Pulihkan Versi"
+        message={
+          <>
+            Kembalikan isi <strong>{labelPeraturan(row)}</strong> ke versi <strong>{target?.rev.versi}</strong>?
+            Kolom yang akan berubah: <strong>{target?.selisih.map((s) => s.label).join(', ')}</strong>.
+            Versi saat ini tetap tersimpan di riwayat.
+          </>
+        }
+        confirmLabel="Pulihkan"
+        busyLabel="Memulihkan..."
+        busy={restoring}
+        onConfirm={handlePulihkan}
+        onCancel={() => setTarget(null)}
+      />
+    </div>
+  );
+}
diff --git a/lib/peraturanRevisi.js b/lib/peraturanRevisi.js
new file mode 100644
index 0000000..08cd656
--- /dev/null
+++ b/lib/peraturanRevisi.js
@@ -0,0 +1,96 @@
+// Helper bersama riwayat revisi peraturan (components/peraturan/RevisiPanel.js,
+// app/employee/peraturan/terhapus). Tabel dan RPC-nya ada di
+// sql/20261014_peraturan_revisi.sql.
+import { friendlyError } from '@/lib/errorMessage';
+import { formatTanggal, formatUkuranBerkas } from '@/lib/peraturanConfig';
+
+// Kolom isi yang ikut dipulihkan. HARUS sama dengan c_isi di fungsi SQL
+// pulihkan_peraturan_revisi().
+export const REVISI_KOLOM_ISI = [
+  { key: 'jenis', label: 'Jenis' },
+  { key: 'nomor', label: 'Nomor' },
+  { key: 'tahun', label: 'Tahun' },
+  { key: 'judul', label: 'Judul' },
+  { key: 'tentang', label: 'Tentang' },
+  { key: 'tanggal_ditetapkan', label: 'Tanggal Ditetapkan', tipe: 'tanggal' },
+  { key: 'tanggal_berlaku', label: 'Tanggal Berlaku', tipe: 'tanggal' },
+  { key: 'status', label: 'Status' },
+  { key: 'ringkasan', label: 'Ringkasan' },
+  { key: 'url_sumber', label: 'URL Sumber Resmi' },
+  { key: 'url_pdf', label: 'URL Berkas PDF' },
+  { key: 'topik', label: 'Topik', tipe: 'daftar' },
+  { key: 'keywords', label: 'Keyword', tipe: 'daftar' },
+];
+
+// Dicatat di riwayat tetapi TIDAK dipulihkan (berkas di Drive sudah dihapus
+// saat PDF diganti atau peraturan dihapus). Hanya ditampilkan di diff.
+export const REVISI_KOLOM_PDF = [
+  { key: 'pdf_nama', label: 'Berkas PDF unggahan', tipe: 'pdf' },
+];
+
+export const AKSI_REVISI_LABEL = {
+  awal: 'Cadangan awal',
+  buat: 'Dibuat',
+  ubah: 'Diubah',
+  hapus: 'Dihapus',
+};
+
+export const REVISI_LIST_COLUMNS =
+  'id, versi, aksi, diubah_oleh, diubah_pada, sumber_revisi_id, jumlah_relasi, jumlah_pasal';
+export const REVISI_LIMIT = 50;
+
+// Nilai kolom -> teks tampilan.
+export function tampilkanNilai(kolom, value) {
+  if (value == null || value === '' || (Array.isArray(value) && value.length === 0)) return '—';
+  if (kolom.tipe === 'tanggal') return formatTanggal(value);
+  if (kolom.tipe === 'daftar') return value.join(', ');
+  return String(value);
+}
+
+// Bentuk pembanding: daftar diurutkan dulu (urutan topik/keyword tidak dianggap perubahan di UI).
+function bentuk(kolom, value) {
+  if (value == null || value === '') return '';
+  if (kolom.tipe === 'daftar') return JSON.stringify([...value].sort());
+  return String(value);
+}
+
+// Selisih dua snapshot untuk kolom tertentu: [{ key, label, sebelum, sesudah }].
+export function selisihSnapshot(sebelum, sesudah, kolomList = REVISI_KOLOM_ISI) {
+  const a = sebelum || {};
+  const b = sesudah || {};
+  return kolomList
+    .filter((k) => bentuk(k, a[k.key]) !== bentuk(k, b[k.key]))
+    .map((k) => ({
+      key: k.key,
+      label: k.label,
+      sebelum: tampilkanNilai(k, a[k.key]),
+      sesudah: tampilkanNilai(k, b[k.key]),
+    }));
+}
+
+// Ringkasan berkas PDF untuk baris info di diff, mis. "dokumen.pdf (1,2 MB)".
+export function ringkasPdf(snapshot) {
+  if (!snapshot?.pdf_nama) return '';
+  const ukuran = formatUkuranBerkas(snapshot.pdf_ukuran);
+  return ukuran ? `${snapshot.pdf_nama} (${ukuran})` : snapshot.pdf_nama;
+}
+
+// Pesan error RPC: pesan Indonesia dari fungsi SQL (SQLSTATE 'PR001') ditampilkan
+// apa adanya; error lain dipetakan lewat friendlyError.
+export function pesanErrorRevisi(err, fallback, context) {
+  if (err?.code === 'PR001' && err.message) return err.message;
+  return friendlyError(err, fallback, { context });
+}
+
+// Nama karyawan untuk daftar id: { [id]: nama }. Gagal -> objek kosong
+// (nama hanya pelengkap; tampilan jatuh ke "—").
+export async function muatNamaKaryawan(supabase, ids) {
+  const unik = [...new Set((ids || []).filter(Boolean))];
+  if (unik.length === 0) return {};
+  const { data, error } = await supabase.from('employees').select('id, nama').in('id', unik);
+  if (error) {
+    console.error('Gagal memuat nama karyawan untuk riwayat:', error);
+    return {};
+  }
+  return Object.fromEntries((data || []).map((e) => [e.id, e.nama]));
+}
diff --git a/sql/20261014_peraturan_revisi.sql b/sql/20261014_peraturan_revisi.sql
new file mode 100644
index 0000000..765dcb2
--- /dev/null
+++ b/sql/20261014_peraturan_revisi.sql
@@ -0,0 +1,382 @@
+-- =============================================================================
+-- Riwayat revisi + pulihkan — modul Peraturan Ketenagakerjaan
+-- File : sql/20261014_peraturan_revisi.sql
+-- Jalankan di Supabase SQL Editor SEBELUM men-deploy kode yang memakainya.
+-- Idempotent: aman dijalankan ulang (CREATE OR REPLACE / IF NOT EXISTS / DROP ... IF EXISTS).
+--
+-- Prasyarat: tabel peraturan, peraturan_relasi, peraturan_pasal, employees, dan
+-- employee_modules sudah ada.
+--
+-- Isi:
+--   1. helper: peraturan_revisi_akses(), peraturan_revisi_pelaku(), peraturan_revisi_bersih()
+--   2. tabel peraturan_revisi (+ RLS: baca = pemegang flag; TIDAK ada policy tulis)
+--   3. trigger pada peraturan (buat/ubah = AFTER, hapus = BEFORE)
+--   4. backfill 1 revisi 'awal' untuk peraturan yang sudah ada
+--   5. RPC pulihkan_peraturan_revisi(uuid) dan daftar_peraturan_terhapus()
+--
+-- Catatan desain:
+--   * peraturan_revisi.peraturan_id TANPA foreign key, supaya riwayat bertahan
+--     setelah peraturan dihapus.
+--   * Penghapusan memakai trigger BEFORE DELETE: relasi dan pasal ikut di-cascade
+--     oleh FK, jadi harus disalin ke revisi SEBELUM baris dihapus.
+--   * Nomor versi aman dari balapan: update/hapus pada baris yang sama sudah
+--     diserialkan oleh row lock, dan unique (peraturan_id, versi) jadi jaring pengaman.
+--   * Trigger fail-closed: bila trigger error, update/hapus peraturan ikut gagal.
+--     Itu disengaja (lebih baik gagal daripada hapus tanpa cadangan).
+--   * Berkas PDF unggahan (pdf_drive_id, pdf_nama, pdf_ukuran) tercatat di snapshot
+--     tetapi TIDAK dipulihkan: berkas di Drive sudah dihapus saat peraturan
+--     dihapus atau PDF-nya diganti.
+-- =============================================================================
+
+begin;
+
+-- 1. Helper -------------------------------------------------------------------
+
+-- Hak akses modul. p_tulis = false: pemegang flag peraturan_ketenagakerjaan.
+-- p_tulis = true: pemegang flag yang juga superadmin. SECURITY DEFINER supaya
+-- membaca employees/employee_modules tidak terkena RLS (menghindari rekursi).
+create or replace function public.peraturan_revisi_akses(p_tulis boolean default false)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select exists (
+    select 1
+    from public.employees e
+    join public.employee_modules m
+      on m.employee_id = e.id
+     and m.module_name = 'peraturan_ketenagakerjaan'
+    where lower(e.email) = lower(coalesce(auth.jwt() ->> 'email', ''))
+      and e.status = 'Aktif'
+      and (not p_tulis or coalesce(e.is_superadmin, false))
+  );
+$$;
+
+-- id employees milik akun yang sedang login; NULL bila tanpa sesi (SQL Editor).
+create or replace function public.peraturan_revisi_pelaku()
+returns uuid
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select e.id
+  from public.employees e
+  where lower(e.email) = lower(coalesce(auth.jwt() ->> 'email', ''))
+  limit 1;
+$$;
+
+-- Buang kolom internal pencarian (search_*, *_tsv) dari jsonb baris. Dengan
+-- p_tanpa_audit = true, updated_at/updated_by juga dibuang (untuk membandingkan isi).
+create or replace function public.peraturan_revisi_bersih(p jsonb, p_tanpa_audit boolean default false)
+returns jsonb
+language sql
+immutable
+as $$
+  select coalesce(jsonb_object_agg(j.key, j.value), '{}'::jsonb)
+  from jsonb_each(p) j
+  where j.key !~ '(^search_|_tsv$|_tsvector$)'
+    and not (p_tanpa_audit and j.key in ('updated_at', 'updated_by'));
+$$;
+
+-- 2. Tabel --------------------------------------------------------------------
+
+create table if not exists public.peraturan_revisi (
+  id               uuid primary key default gen_random_uuid(),
+  peraturan_id     uuid not null,                       -- TANPA FK (riwayat bertahan setelah hapus)
+  versi            int  not null check (versi >= 1),
+  aksi             text not null check (aksi in ('awal', 'buat', 'ubah', 'hapus')),
+  snapshot         jsonb not null,                      -- keadaan baris SETELAH aksi (untuk 'hapus': sebelum dihapus)
+  relasi           jsonb,                               -- hanya 'hapus': relasi masuk + keluar
+  pasal            jsonb,                               -- hanya 'hapus': seluruh pasal
+  jumlah_relasi    int,
+  jumlah_pasal     int,
+  sumber_revisi_id uuid,                                -- bila revisi ini hasil pemulihan: revisi yang dipulihkan
+  diubah_oleh      uuid,                                -- employees.id (tanpa FK); NULL = sistem / SQL Editor
+  diubah_pada      timestamptz not null default now(),
+  unique (peraturan_id, versi)
+);
+
+create index if not exists peraturan_revisi_hapus_idx
+  on public.peraturan_revisi (diubah_pada desc)
+  where aksi = 'hapus';
+
+alter table public.peraturan_revisi enable row level security;
+
+drop policy if exists peraturan_revisi_select on public.peraturan_revisi;
+create policy peraturan_revisi_select on public.peraturan_revisi
+  for select to authenticated
+  using (public.peraturan_revisi_akses(false));
+
+-- Sengaja TIDAK ada policy insert/update/delete: hanya trigger (SECURITY DEFINER)
+-- yang menulis, dan riwayat tidak bisa diubah dari klien.
+revoke all on public.peraturan_revisi from anon, authenticated;
+grant select on public.peraturan_revisi to authenticated;
+
+-- 3. Trigger ------------------------------------------------------------------
+
+create or replace function public.peraturan_revisi_catat()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_id     uuid;
+  v_aksi   text;
+  v_snap   jsonb;
+  v_relasi jsonb;
+  v_pasal  jsonb;
+  v_jr     int;
+  v_jp     int;
+  v_versi  int;
+  v_sumber uuid;
+begin
+  if tg_op = 'DELETE' then
+    v_id := old.id;
+  else
+    v_id := new.id;
+  end if;
+
+  if tg_op = 'UPDATE' then
+    -- Lewati bila hanya updated_at/updated_by/kolom pencarian yang berubah.
+    if public.peraturan_revisi_bersih(to_jsonb(old), true) = public.peraturan_revisi_bersih(to_jsonb(new), true) then
+      return new;
+    end if;
+    v_aksi := 'ubah';
+    v_snap := public.peraturan_revisi_bersih(to_jsonb(new));
+  elsif tg_op = 'INSERT' then
+    v_aksi := 'buat';
+    v_snap := public.peraturan_revisi_bersih(to_jsonb(new));
+  else
+    v_aksi := 'hapus';
+    v_snap := public.peraturan_revisi_bersih(to_jsonb(old));
+
+    select coalesce(jsonb_agg(jsonb_build_object(
+             'peraturan_id', r.peraturan_id,
+             'terkait_id',   r.terkait_id,
+             'jenis_relasi', r.jenis_relasi,
+             'catatan',      r.catatan)), '[]'::jsonb),
+           count(*)
+      into v_relasi, v_jr
+      from public.peraturan_relasi r
+     where r.peraturan_id = old.id or r.terkait_id = old.id;
+
+    select coalesce(jsonb_agg(public.peraturan_revisi_bersih(to_jsonb(s)) order by s.urutan), '[]'::jsonb),
+           count(*)
+      into v_pasal, v_jp
+      from public.peraturan_pasal s
+     where s.peraturan_id = old.id;
+  end if;
+
+  select coalesce(max(r.versi), 0) + 1 into v_versi
+    from public.peraturan_revisi r
+   where r.peraturan_id = v_id;
+
+  -- Diisi oleh pulihkan_peraturan_revisi() lewat set_config (lokal transaksi).
+  v_sumber := nullif(current_setting('peraturan.sumber_revisi', true), '')::uuid;
+
+  insert into public.peraturan_revisi
+    (peraturan_id, versi, aksi, snapshot, relasi, pasal, jumlah_relasi, jumlah_pasal,
+     sumber_revisi_id, diubah_oleh)
+  values
+    (v_id, v_versi, v_aksi, v_snap, v_relasi, v_pasal, v_jr, v_jp,
+     v_sumber, public.peraturan_revisi_pelaku());
+
+  if tg_op = 'DELETE' then
+    return old;
+  end if;
+  return new;
+end;
+$$;
+
+revoke all on function public.peraturan_revisi_catat() from public;
+
+drop trigger if exists peraturan_revisi_catat_ubah on public.peraturan;
+create trigger peraturan_revisi_catat_ubah
+  after insert or update on public.peraturan
+  for each row execute function public.peraturan_revisi_catat();
+
+drop trigger if exists peraturan_revisi_catat_hapus on public.peraturan;
+create trigger peraturan_revisi_catat_hapus
+  before delete on public.peraturan
+  for each row execute function public.peraturan_revisi_catat();
+
+-- 4. Backfill -----------------------------------------------------------------
+-- Satu revisi 'awal' untuk peraturan yang belum punya riwayat. Pelaku NULL:
+-- siapa pembuat/pengubah asli ada di snapshot (created_by, updated_by).
+
+insert into public.peraturan_revisi (peraturan_id, versi, aksi, snapshot)
+select p.id, 1, 'awal', public.peraturan_revisi_bersih(to_jsonb(p))
+from public.peraturan p
+where not exists (select 1 from public.peraturan_revisi r where r.peraturan_id = p.id);
+
+-- 5. RPC ----------------------------------------------------------------------
+
+-- Memulihkan satu revisi. Hanya superadmin pemegang flag (dicek DI DALAM fungsi).
+--   * revisi 'hapus'            : peraturan dibuat ulang (id sama) beserta relasi & pasal.
+--   * revisi 'awal'/'buat'/'ubah': isi peraturan yang ada dikembalikan ke snapshot.
+-- Pemulihan selalu menambah revisi baru; riwayat lama tidak ditimpa.
+-- Error yang boleh tampil ke pengguna memakai SQLSTATE 'PR001' (pesan Indonesia).
+create or replace function public.pulihkan_peraturan_revisi(p_revisi_id uuid)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  c_isi constant text[] := array[
+    'jenis', 'nomor', 'tahun', 'judul', 'tentang', 'tanggal_ditetapkan', 'tanggal_berlaku',
+    'status', 'ringkasan', 'url_sumber', 'url_pdf', 'topik', 'keywords'
+  ];
+  v_rev    public.peraturan_revisi%rowtype;
+  v_rec    public.peraturan%rowtype;
+  v_ada    boolean;
+  v_pelaku uuid;
+  v_sama   boolean;
+  v_dil    int := 0;
+  v_lewat  int := 0;
+  v_pasal  int := 0;
+  v_baru   int;
+begin
+  if not public.peraturan_revisi_akses(true) then
+    raise exception 'Kamu tidak punya izin memulihkan peraturan.' using errcode = '42501';
+  end if;
+
+  select * into v_rev from public.peraturan_revisi where id = p_revisi_id;
+  if not found then
+    raise exception 'Revisi tidak ditemukan.' using errcode = 'PR001';
+  end if;
+
+  select exists (select 1 from public.peraturan p where p.id = v_rev.peraturan_id) into v_ada;
+  select * into v_rec from jsonb_populate_record(null::public.peraturan, v_rev.snapshot);
+  v_pelaku := public.peraturan_revisi_pelaku();
+
+  perform set_config('peraturan.sumber_revisi', p_revisi_id::text, true);
+
+  if v_rev.aksi = 'hapus' then
+    if v_ada then
+      raise exception 'Peraturan ini sudah ada kembali (mungkin sudah dipulihkan). Muat ulang halaman.' using errcode = 'PR001';
+    end if;
+
+    begin
+      insert into public.peraturan
+        (id, jenis, nomor, tahun, judul, tentang, tanggal_ditetapkan, tanggal_berlaku, status,
+         ringkasan, url_sumber, url_pdf, topik, keywords, created_by, created_at)
+      values
+        (v_rec.id, v_rec.jenis, v_rec.nomor, v_rec.tahun, v_rec.judul, v_rec.tentang,
+         v_rec.tanggal_ditetapkan, v_rec.tanggal_berlaku, v_rec.status, v_rec.ringkasan,
+         v_rec.url_sumber, v_rec.url_pdf, v_rec.topik, v_rec.keywords,
+         case when exists (select 1 from public.employees e where e.id = v_rec.created_by)
+              then v_rec.created_by else v_pelaku end,
+         coalesce(v_rec.created_at, now()));
+    exception when unique_violation then
+      raise exception 'Tidak bisa dipulihkan: sudah ada peraturan lain dengan jenis, nomor, dan tahun yang sama.' using errcode = 'PR001';
+    end;
+
+    -- Relasi: hanya yang kedua ujungnya masih ada.
+    insert into public.peraturan_relasi (peraturan_id, terkait_id, jenis_relasi, catatan)
+    select r.peraturan_id, r.terkait_id, r.jenis_relasi, r.catatan
+    from jsonb_populate_recordset(null::public.peraturan_relasi, coalesce(v_rev.relasi, '[]'::jsonb)) r
+    where exists (select 1 from public.peraturan p where p.id = r.peraturan_id)
+      and exists (select 1 from public.peraturan p where p.id = r.terkait_id)
+    on conflict do nothing;
+    get diagnostics v_dil = row_count;
+    v_lewat := greatest(coalesce(v_rev.jumlah_relasi, 0) - v_dil, 0);
+
+    insert into public.peraturan_pasal
+      (id, peraturan_id, nomor_pasal, urutan, judul, isi, catatan, created_at, updated_at)
+    select s.id, s.peraturan_id, s.nomor_pasal, s.urutan, s.judul, s.isi, s.catatan,
+           coalesce(s.created_at, now()), coalesce(s.updated_at, now())
+    from jsonb_populate_recordset(null::public.peraturan_pasal, coalesce(v_rev.pasal, '[]'::jsonb)) s
+    on conflict do nothing;
+    get diagnostics v_pasal = row_count;
+  else
+    if not v_ada then
+      raise exception 'Peraturan ini sudah dihapus. Pulihkan dari halaman Terhapus.' using errcode = 'PR001';
+    end if;
+
+    select (
+             (select jsonb_object_agg(j.key, j.value) from jsonb_each(v_rev.snapshot) j where j.key = any (c_isi))
+             is not distinct from
+             (select jsonb_object_agg(j.key, j.value) from jsonb_each(to_jsonb(p)) j where j.key = any (c_isi))
+           )
+      into v_sama
+      from public.peraturan p
+     where p.id = v_rev.peraturan_id;
+    if v_sama then
+      raise exception 'Isi peraturan sudah sama dengan versi ini; tidak ada yang dipulihkan.' using errcode = 'PR001';
+    end if;
+
+    begin
+      update public.peraturan
+         set jenis = v_rec.jenis, nomor = v_rec.nomor, tahun = v_rec.tahun, judul = v_rec.judul,
+             tentang = v_rec.tentang, tanggal_ditetapkan = v_rec.tanggal_ditetapkan,
+             tanggal_berlaku = v_rec.tanggal_berlaku, status = v_rec.status,
+             ringkasan = v_rec.ringkasan, url_sumber = v_rec.url_sumber, url_pdf = v_rec.url_pdf,
+             topik = v_rec.topik, keywords = v_rec.keywords
+       where id = v_rev.peraturan_id;
+    exception when unique_violation then
+      raise exception 'Tidak bisa dipulihkan: jenis, nomor, dan tahun pada versi ini sudah dipakai peraturan lain.' using errcode = 'PR001';
+    end;
+  end if;
+
+  select max(r.versi) into v_baru from public.peraturan_revisi r where r.peraturan_id = v_rev.peraturan_id;
+  perform set_config('peraturan.sumber_revisi', '', true);
+
+  return jsonb_build_object(
+    'peraturan_id',      v_rev.peraturan_id,
+    'versi_sumber',      v_rev.versi,
+    'aksi_sumber',       v_rev.aksi,
+    'versi_baru',        v_baru,
+    'relasi_dipulihkan', v_dil,
+    'relasi_dilewati',   v_lewat,
+    'pasal_dipulihkan',  v_pasal
+  );
+end;
+$$;
+
+revoke all on function public.pulihkan_peraturan_revisi(uuid) from public, anon;
+grant execute on function public.pulihkan_peraturan_revisi(uuid) to authenticated;
+
+-- Peraturan yang SAAT INI terhapus (revisi terakhirnya = 'hapus'). SECURITY INVOKER:
+-- RLS peraturan_revisi yang berlaku (pemegang flag). Tanpa kolom jsonb besar.
+create or replace function public.daftar_peraturan_terhapus()
+returns table (
+  revisi_id     uuid,
+  peraturan_id  uuid,
+  versi         int,
+  jenis         text,
+  nomor         text,
+  tahun         int,
+  judul         text,
+  status        text,
+  jumlah_relasi int,
+  jumlah_pasal  int,
+  dihapus_oleh  uuid,
+  dihapus_pada  timestamptz
+)
+language sql
+stable
+security invoker
+set search_path = public
+as $$
+  select r.id, r.peraturan_id, r.versi,
+         r.snapshot ->> 'jenis', r.snapshot ->> 'nomor', (r.snapshot ->> 'tahun')::int,
+         r.snapshot ->> 'judul', r.snapshot ->> 'status',
+         coalesce(r.jumlah_relasi, 0), coalesce(r.jumlah_pasal, 0),
+         r.diubah_oleh, r.diubah_pada
+  from public.peraturan_revisi r
+  where r.aksi = 'hapus'
+    and r.versi = (select max(x.versi) from public.peraturan_revisi x where x.peraturan_id = r.peraturan_id)
+    and not exists (select 1 from public.peraturan p where p.id = r.peraturan_id)
+  order by r.diubah_pada desc
+  limit 200;
+$$;
+
+revoke all on function public.daftar_peraturan_terhapus() from public, anon;
+grant execute on function public.daftar_peraturan_terhapus() to authenticated;
+
+commit;
