- sql/20261014_peraturan_revisi.sql: tabel peraturan_revisi (RLS baca =
  pemegang flag, tanpa policy tulis), trigger catat buat/ubah/hapus,
  backfill versi awal, RPC pulihkan_peraturan_revisi dan
