From 24871edf87c5184f6092c5c0470dc5a55040b69b Mon Sep 17 00:00:00 2001
From: Gegs <gegs@users.noreply.github.com>
Date: Wed, 21 Oct 2026 11:48:19 +0000
Subject: [PATCH] fix(employee): normalisasi email karyawan (trim + lowercase)

- /api/employee/create: email di-trim + lowercase sebelum invite Auth dan
  insert ke employees (sama seperti bulk-create), supaya cocok dengan email
  Auth yang selalu huruf kecil dan lookup .eq('email', user.email).
- Migrasi supabase/migrations/20261021_employees_email_normalize.sql:
  pre-check duplikat, rapikan data lama, unique index lower(email), dan
  trigger pengaman normalisasi email saat INSERT/UPDATE. Idempotent.
---
 app/api/employee/create/route.js              | 12 +++-
 .../20261021_employees_email_normalize.sql    | 70 +++++++++++++++++++
 2 files changed, 79 insertions(+), 3 deletions(-)
 create mode 100644 supabase/migrations/20261021_employees_email_normalize.sql

diff --git a/app/api/employee/create/route.js b/app/api/employee/create/route.js
index ca48c6c..10d309d 100644
--- a/app/api/employee/create/route.js
+++ b/app/api/employee/create/route.js
@@ -48,7 +48,13 @@ export async function POST(request) {
     const { nama, email, client_id, status, is_superadmin } = body;
     let { employee_id } = body;
 
-    if (!nama || !email) {
+    // Email = identitas login. Supabase Auth menyimpan email dalam huruf kecil
+    // dan semua lookup `.eq('email', user.email)` membandingkan persis, jadi
+    // email WAJIB dinormalisasi (trim + lowercase) sebelum dipakai di Auth
+    // maupun tabel employees — sama seperti bulk-create.
+    const emailNorm = String(email ?? '').trim().toLowerCase();
+
+    if (!nama || !emailNorm) {
       return NextResponse.json({ error: 'Nama dan email wajib diisi.' }, { status: 400 });
     }
 
@@ -68,7 +74,7 @@ export async function POST(request) {
     // employee klik link di email lalu diarahkan ke /employee/set-password
     // untuk buat password sendiri. Lihat juga: middleware.js (path ini wajib
     // masuk PUBLIC_EMPLOYEE_PATHS) dan app/employee/set-password/page.js.
-    const { data: authUser, error: authError } = await admin.auth.admin.inviteUserByEmail(email, {
+    const { data: authUser, error: authError } = await admin.auth.admin.inviteUserByEmail(emailNorm, {
       redirectTo: `${request.nextUrl.origin}/employee/set-password`,
       data: { nama, employee_id },
     });
@@ -86,7 +92,7 @@ export async function POST(request) {
         {
           nama,
           employee_id,
-          email,
+          email: emailNorm,
           client_id: client_id || null,
           status: status || 'Aktif',
           is_superadmin: !!is_superadmin,
diff --git a/supabase/migrations/20261021_employees_email_normalize.sql b/supabase/migrations/20261021_employees_email_normalize.sql
new file mode 100644
index 0000000..2852b4e
--- /dev/null
+++ b/supabase/migrations/20261021_employees_email_normalize.sql
@@ -0,0 +1,70 @@
+-- Normalisasi email karyawan (employees.email)
+--
+-- Latar belakang:
+--   Supabase Auth menyimpan email dalam huruf kecil, sedangkan lookup di
+--   aplikasi memakai `.eq('email', user.email)` (perbandingan persis). Email
+--   yang tersimpan dengan huruf besar/spasi di tabel employees membuat login
+--   menampilkan "Akun ini belum terdaftar".
+--
+-- Isi migrasi (idempotent, aman dijalankan berulang):
+--   1. Cek duplikat email yang hanya beda huruf besar/kecil/spasi. Kalau ada,
+--      migrasi BERHENTI dengan daftar duplikatnya (rapikan manual dulu).
+--   2. Rapikan data lama: email = lower(btrim(email)).
+--   3. Unique index pada lower(email).
+--   4. Trigger pengaman: email selalu di-trim + lowercase saat INSERT/UPDATE,
+--      termasuk kalau baris diubah langsung lewat Supabase Dashboard / SQL.
+--
+-- Cara menjalankan: Supabase Dashboard > SQL Editor > tempel seluruh isi file
+-- ini > Run. Tidak perlu RLS baru (tidak ada tabel baru).
+
+-- 1. Pre-check duplikat -----------------------------------------------------
+DO $$
+DECLARE
+  dup_list text;
+BEGIN
+  SELECT string_agg(format('%s (%s baris)', em, cnt), ', ')
+    INTO dup_list
+  FROM (
+    SELECT lower(btrim(email)) AS em, count(*) AS cnt
+    FROM public.employees
+    WHERE email IS NOT NULL
+    GROUP BY lower(btrim(email))
+    HAVING count(*) > 1
+  ) d;
+
+  IF dup_list IS NOT NULL THEN
+    RAISE EXCEPTION
+      'Ada email duplikat (beda huruf besar/kecil/spasi): %. Gabungkan atau hapus salah satunya dulu, lalu jalankan ulang migrasi ini.',
+      dup_list;
+  END IF;
+END $$;
+
+-- 2. Rapikan data lama ------------------------------------------------------
+UPDATE public.employees
+SET email = lower(btrim(email))
+WHERE email IS NOT NULL
+  AND email IS DISTINCT FROM lower(btrim(email));
+
+-- 3. Unique index lower(email) ----------------------------------------------
+CREATE UNIQUE INDEX IF NOT EXISTS employees_email_lower_key
+  ON public.employees (lower(email));
+
+-- 4. Trigger normalisasi ----------------------------------------------------
+CREATE OR REPLACE FUNCTION public.employees_normalize_email()
+RETURNS trigger
+LANGUAGE plpgsql
+SET search_path = public
+AS $$
+BEGIN
+  IF NEW.email IS NOT NULL THEN
+    NEW.email := lower(btrim(NEW.email));
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS employees_normalize_email_trg ON public.employees;
+CREATE TRIGGER employees_normalize_email_trg
+  BEFORE INSERT OR UPDATE OF email ON public.employees
+  FOR EACH ROW
+  EXECUTE FUNCTION public.employees_normalize_email();
-- 
2.43.0

