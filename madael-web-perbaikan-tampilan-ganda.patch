+  );
+}
+
+function DuplicatePanel({ duplicates }) {
+  return (
+    <div className="px-8 py-4">
+      <p className="text-xs font-medium text-[#92700C] mb-2.5">
+        Email atau nomor telepon sama dengan lamaran berikut — kemungkinan kandidat yang sama
