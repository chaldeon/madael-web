+        link: '/employee/absensi/karyawan',
+      });
     } catch (err) {
       setKoreksiError(friendlyCaught(err, 'Gagal mengirim pengajuan koreksi.'));
     } finally {
@@ -711,6 +719,11 @@ export default function AbsensiPage() {
