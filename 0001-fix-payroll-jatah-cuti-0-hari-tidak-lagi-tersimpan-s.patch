From 4f076ed17901783d92f3ea6a2816201dc57fcee2 Mon Sep 17 00:00:00 2001
From: Gegs <gegs@users.noreply.github.com>
Date: Tue, 27 Oct 2026 06:17:47 +0000
Subject: [PATCH] fix(payroll): jatah cuti 0 hari tidak lagi tersimpan sebagai
 12

Form Payroll Manager memakai Number(x) || 12, sehingga 0 (mis. magang tanpa
hak cuti) dianggap falsy dan diganti 12. Tambah parseJatahCutiKaryawan di
lib/leavePolicy.js: kosong -> default 12, 0 diterima apa adanya, validasi
bilangan bulat 0-365. Pesan error ditampilkan lewat saveError.
---
 app/employee/payroll/page.js |  8 +++++++-
 lib/leavePolicy.js           | 16 ++++++++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/app/employee/payroll/page.js b/app/employee/payroll/page.js
index a39c60d..f7c4d46 100644
--- a/app/employee/payroll/page.js
+++ b/app/employee/payroll/page.js
@@ -21,6 +21,7 @@ import { currentMonthValue, EMPTY_FORM, totalTunjangan, SORT_COLUMNS, objToPairs
 import { formatRupiah } from '@/lib/format';
 import { validateKepegawaian } from '@/lib/kepegawaian';
 import { tahunSekarang } from '@/lib/leave';
+import { parseJatahCutiKaryawan } from '@/lib/leavePolicy';
 import { friendlyError, friendlyCaught } from '@/lib/errorMessage';
 import { UPLOAD_MAX_BYTES, UPLOAD_MAX_LABEL, PESAN_UKURAN_UPLOAD, readUploadJson } from '@/lib/uploadLimits';
 
@@ -191,6 +192,11 @@ export default function PayrollManagerPage() {
       setSaveError(kepegawaianError);
       return;
     }
+    const jatahCuti = parseJatahCutiKaryawan(form.jatah_cuti_tahunan);
+    if (jatahCuti.error) {
+      setSaveError(jatahCuti.error);
+      return;
+    }
     setSaving(true);
 
     const payload = {
@@ -213,7 +219,7 @@ export default function PayrollManagerPage() {
       no_bpjs_ketenagakerjaan: form.no_bpjs_ketenagakerjaan.trim() || null,
       nama_rekening: form.nama_rekening.trim() || null,
       no_rekening: form.no_rekening.trim() || null,
-      jatah_cuti_tahunan: Number(form.jatah_cuti_tahunan) || 12,
+      jatah_cuti_tahunan: jatahCuti.value,
       // Carry-over ditulis hanya kalau HR mengubahnya, supaya hitungan otomatis tidak terkunci.
       ...(Number(form.cuti_carry_over) !== Number(formBaselineRef.current.cuti_carry_over)
         ? { cuti_carry_over: Number(form.cuti_carry_over) || 0, cuti_carry_over_tahun: tahunSekarang() }
diff --git a/lib/leavePolicy.js b/lib/leavePolicy.js
index 00c0ecb..41877c6 100644
--- a/lib/leavePolicy.js
+++ b/lib/leavePolicy.js
@@ -16,6 +16,22 @@ export const DEFAULT_KEBIJAKAN_CUTI = Object.freeze({
 
 export const BATAS_KEBIJAKAN_CUTI = { min: 0, max: 60 };
 
+// Batas jatah cuti tahunan per karyawan (hari) di form Payroll Manager.
+export const BATAS_JATAH_CUTI_KARYAWAN = { min: 0, max: 365 };
+
+// Nilai form jatah cuti per karyawan -> { value } atau { error }.
+// Kosong ('' / null / undefined) = jatah default; 0 adalah nilai sah (mis. magang
+// tanpa hak cuti) dan TIDAK boleh diganti default, jadi jangan pakai `|| 12`.
+export function parseJatahCutiKaryawan(raw, fallback = DEFAULT_KEBIJAKAN_CUTI.jatah_default) {
+  if (raw === '' || raw === null || raw === undefined) return { value: fallback };
+  const n = Number(raw);
+  const { min, max } = BATAS_JATAH_CUTI_KARYAWAN;
+  if (!Number.isInteger(n) || n < min || n > max) {
+    return { error: `Jatah cuti tahunan harus bilangan bulat ${min}–${max} hari.` };
+  }
+  return { value: n };
+}
+
 // Tanggal hari ini menurut WIB, format 'YYYY-MM-DD' (server Vercel berjalan di UTC).
 export function tanggalHariIni() {
   return new Intl.DateTimeFormat('en-CA', {
